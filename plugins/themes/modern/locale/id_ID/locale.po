msgid "plugins.themes.modern.name"
msgstr "Tema Modern"

msgid "plugins.themes.modern.description"
msgstr "Tema ini menggunakan tema modern."

msgid "plugins.themes.modern.option.typography.label"
msgstr "Tipografi"

msgid "plugins.themes.modern.option.typography.description"
msgstr "Silakan pilih kombinasi huruf sesuai dengan jurnal Anda."

msgid "plugins.themes.modern.option.typography.notoSans"
msgstr ""
"Noto Sans: Sebuah huruf digital yang dirancang oleh Google untuk mendukung "
"semua bahasa."

msgid "plugins.themes.modern.option.typography.notoSerif"
msgstr "Noto Serif: Sebuah varian Serif dari huruf digital asli Google."

msgid "plugins.themes.modern.option.typography.notoSerif_notoSans"
msgstr ""
"Noto Serif/Noto Sans: Gabungan yang saling melengkapi di mana heading "
"menggunakan serif dan isi teks menggunakan sans-serif."

msgid "plugins.themes.modern.option.typography.notoSans_notoSerif"
msgstr ""
"Noto Sans/Noto Serif: Gabungan yang saling melengkapi di mana heading "
"menggunakan ssans-serif dan isi teks menggunakan serif."

msgid "plugins.themes.modern.option.typography.lato"
msgstr "Lato: Jenis huruf sans-serif yang populer dan modern."

msgid "plugins.themes.modern.option.typography.lora"
msgstr ""
"Lora: Jenis huruf serif yang banyak diakai dan cocok buat membaca daring."

msgid "plugins.themes.modern.option.typography.lora_openSans"
msgstr ""
"Lora/Open Sans: Gabungan yang saling melengkapi di mana heading menggunakan "
"serif dan isi teks menggunakan sans-serif."

msgid "plugins.themes.modern.option.colour.label"
msgstr "Warna"

msgid "plugins.themes.modern.option.colour.description"
msgstr "Pilih warna untuk bagian header."

msgid "plugins.themes.modern.option.showDescriptionInJournalIndex.option"
msgstr "Menampilkan riwayat jurnal pada halaman beranda."

msgid "plugins.themes.modern.option.useHomepageImageAsHeader.label"
msgstr "Gambar Latar Header"

msgid "plugins.themes.modern.option.useHomepageImageAsHeader.description"
msgstr ""
"Jika gambar halaman beranda sudah diunggah, tampilkan sebagai latar header "
"bukan sebagaimana umumnya di halaman beranda."

msgid "plugins.themes.modern.option.useHomepageImageAsHeader.option"
msgstr "Tampilkan gambar beranda sebagai latar header."

msgid "plugins.themes.modern.option.statCounter_project_id.description"
msgstr "Project ID dari StatCounter (mis. 13121706). Kosongkan untuk menonaktifkan."

msgid "plugins.themes.modern.option.statCounter_security_id.description"
msgstr "Security ID dari StatCounter."

msgid "plugins.themes.modern.option.colourPreset.custom"
msgstr "Kustom — gunakan warna manual di bawah"

msgid "plugins.themes.modern.option.colourPreset.description"
msgstr "Pilih palet warna siap pakai, atau \"Kustom\" untuk mengatur warna sendiri."

msgid "plugins.themes.modern.option.customHeaderColour.description"
msgstr "Hanya berlaku jika preset = Kustom. Default: #1E6292."

msgid "plugins.themes.modern.option.customAccentColour.description"
msgstr "Warna untuk link, tombol, dan elemen interaktif. Hanya berlaku jika preset = Kustom."

msgid "plugins.themes.modern.option.headerStyle.description"
msgstr "Pilih tampilan latar belakang header."

msgid "plugins.themes.modern.option.headerStyle.solid"
msgstr "Solid — warna penuh, klasik"

msgid "plugins.themes.modern.option.headerStyle.gradient"
msgstr "Gradient — gradasi diagonal modern"

msgid "plugins.themes.modern.option.headerStyle.glass"
msgstr "Glass — transparan dengan blur (cocok dengan gambar header)"

msgid "plugins.themes.modern.option.borderRadius.label"
msgstr "Sudut Komponen (Border Radius)"

msgid "plugins.themes.modern.option.borderRadius.description"
msgstr "Mengubah seberapa bulat card, button, dan form."

msgid "plugins.themes.modern.option.borderRadius.sharp"
msgstr "Sharp — sudut tegas (2px)"

msgid "plugins.themes.modern.option.borderRadius.rounded"
msgstr "Rounded — sudut sedang (8px) default"

msgid "plugins.themes.modern.option.borderRadius.pill"
msgstr "Pill — sudut sangat membulat (16px)"

msgid "plugins.themes.modern.option.cardStyle.description"
msgstr "Tampilan kartu artikel dan pengumuman."

msgid "plugins.themes.modern.option.cardStyle.flat"
msgstr "Flat — minimalis, tanpa bayangan"

msgid "plugins.themes.modern.option.cardStyle.soft"
msgstr "Soft — bayangan lembut (default)"

msgid "plugins.themes.modern.option.cardStyle.elevated"
msgstr "Elevated — bayangan lebih kuat dan hover lift"

msgid "plugins.themes.modern.option.backgroundImageUrl.label"
msgstr "URL Gambar Latar Belakang"

msgid "plugins.themes.modern.option.backgroundImageUrl.description"
msgstr "Masukkan URL gambar latar belakang untuk halaman beranda. Gambar akan ditampilkan dengan overlay semi-transparan agar teks tetap terbaca."
