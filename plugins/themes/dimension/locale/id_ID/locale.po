msgid "plugins.themes.dimension.name"
msgstr "Tema Bawaan"

msgid "plugins.themes.dimension.description"
msgstr "Tema ini menggunakan tema bawaan."

msgid "plugins.themes.dimension.option.typography.label"
msgstr "Tipografi"

msgid "plugins.themes.dimension.option.typography.description"
msgstr "Silakan pilih kombinasi huruf sesuai dengan jurnal Anda."

msgid "plugins.themes.dimension.option.typography.notoSans"
msgstr ""
"Noto Sans: Sebuah huruf digital yang dirancang oleh Google untuk mendukung "
"semua bahasa."

msgid "plugins.themes.dimension.option.typography.notoSerif"
msgstr "Noto Serif: Sebuah varian Serif dari huruf digital asli Google."

msgid "plugins.themes.dimension.option.typography.notoSerif_notoSans"
msgstr ""
"Noto Serif/Noto Sans: Gabungan yang saling melengkapi di mana heading "
"menggunakan serif dan isi teks menggunakan sans-serif."

msgid "plugins.themes.dimension.option.typography.notoSans_notoSerif"
msgstr ""
"Noto Sans/Noto Serif: Gabungan yang saling melengkapi di mana heading "
"menggunakan ssans-serif dan isi teks menggunakan serif."

msgid "plugins.themes.dimension.option.typography.lato"
msgstr "Lato: Jenis huruf sans-serif yang populer dan modern."

msgid "plugins.themes.dimension.option.typography.lora"
msgstr ""
"Lora: Jenis huruf serif yang banyak diakai dan cocok buat membaca daring."

msgid "plugins.themes.dimension.option.typography.lora_openSans"
msgstr ""
"Lora/Open Sans: Gabungan yang saling melengkapi di mana heading menggunakan "
"serif dan isi teks menggunakan sans-serif."

msgid "plugins.themes.dimension.option.colour.label"
msgstr "Warna"

msgid "plugins.themes.dimension.option.colour.description"
msgstr "Pilih warna untuk bagian header."

msgid "plugins.themes.dimension.option.showDescriptionInJournalIndex.option"
msgstr "Menampilkan riwayat jurnal pada halaman beranda."

msgid "plugins.themes.dimension.option.useHomepageImageAsHeader.label"
msgstr "Gambar Latar Header"

msgid "plugins.themes.dimension.option.useHomepageImageAsHeader.description"
msgstr ""
"Jika gambar halaman beranda sudah diunggah, tampilkan sebagai latar header "
"bukan sebagaimana umumnya di halaman beranda."

msgid "plugins.themes.dimension.option.useHomepageImageAsHeader.option"
msgstr "Tampilkan gambar beranda sebagai latar header."

