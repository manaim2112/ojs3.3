{
  "name": "dimension-ojs-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build tooling for the OJS dimension theme",
  "scripts": {
    "build": "tailwindcss -i styles/main.css -o styles/reboot.css --minify",
    "watch": "tailwindcss -i styles/main.css -o styles/reboot.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "4.3.1",
    "tailwindcss-animated": "^2.1.0"
  }
}
