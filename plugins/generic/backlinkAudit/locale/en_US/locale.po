msgstr "Actor"

msgid "plugins.generic.backlinkAudit.alert.col.account"
msgstr "Account affected"

msgid "plugins.generic.backlinkAudit.alert.col.change"
msgstr "Change"

msgid "plugins.generic.backlinkAudit.alert.unexplained"
msgstr "UNEXPLAINED - not submitted through the OJS interface"

msgid "plugins.generic.backlinkAudit.alert.footer"
msgstr "Open the Backlink Audit report in OJS for the full history. Changes marked UNEXPLAINED did not come through the OJS interface, so the user shown was only the one signed in at the time — the change cannot be attributed to them with certainty. Investigate those first."

