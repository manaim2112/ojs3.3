msgstr "Journal"

msgid "plugins.generic.backlinkAudit.col.source"
msgstr "Source field"

msgid "plugins.generic.backlinkAudit.col.links"
msgstr "Links / Roles (+added / -removed)"

msgid "plugins.generic.backlinkAudit.col.ip"
msgstr "IP / Browser"

msgid "plugins.generic.backlinkAudit.report.bootstrap"
msgstr "Baseline recorded"

msgid "plugins.generic.backlinkAudit.report.tamper"
msgstr "Snapshot emptied - detection rebuilt"

