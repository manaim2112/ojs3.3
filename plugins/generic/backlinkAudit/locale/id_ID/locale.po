msgid "plugins.generic.backlinkAudit.displayName"
msgstr "Audit Backlink"

msgid "plugins.generic.backlinkAudit.description"
msgstr "Mencatat siapa yang memasukkan <a href> ke kolom teks kaya (TinyMCE): user, jurnal, semua tautan, alamat IP. Melacak injeksi backlink spam sampai ke orangnya."

msgid "plugins.generic.backlinkAudit.menu"
msgstr "Audit Backlink"

msgid "plugins.generic.backlinkAudit.report.title"
msgstr "Log Audit Backlink"

msgid "plugins.generic.backlinkAudit.report.description"
msgstr "Setiap penyimpanan kolom teks kaya yang berisi <a href> dicatat di sini: siapa yang menyimpan, di jurnal apa, di field mana, dan semua tautannya (tautan eksternal ditandai). Tombol Scan memeriksa data lama di database untuk tautan yang dimasukkan sebelum plugin ini terpasang."

msgid "plugins.generic.backlinkAudit.report.scanned"
msgstr "Scan selesai: {$count} entri baru ditemukan dan dicatat."

msgid "plugins.generic.backlinkAudit.report.scan"
msgstr "Pindai data lama"

msgid "plugins.generic.backlinkAudit.report.export"
msgstr "Ekspor CSV"

msgid "plugins.generic.backlinkAudit.report.empty"
msgstr "Belum ada aktivitas tautan yang tercatat."

