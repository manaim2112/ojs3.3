msgstr "Tanggal / Aksi"

msgid "plugins.generic.backlinkAudit.col.user"
msgstr "User"

msgid "plugins.generic.backlinkAudit.col.journal"
msgstr "Jurnal"

msgid "plugins.generic.backlinkAudit.col.source"
msgstr "Field sumber"

msgid "plugins.generic.backlinkAudit.col.links"
msgstr "Tautan (+ditambah / -dihapus)"

