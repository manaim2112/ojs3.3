msgstr "Kode Verifikasi"

msgid "plugins.generic.loa.disclaimer"
msgstr "Dokumen ini dibuat secara elektronik dan dapat diverifikasi melalui sistem verifikasi resmi jurnal menggunakan kode unik di atas."

