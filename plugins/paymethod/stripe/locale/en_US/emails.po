msgid "emails.stripeInvestigatePayment.subject"
msgstr "Unusual Stripe Activity"

msgid "emails.stripeInvestigatePayment.body"
msgstr ""
"Open Journal Systems has encountered unusual activity relating to Stripe "
"payment support for the journal {$contextName}. This activity may need "
"further investigation or manual intervention.<br />\n"
"                       <br />\n"
"This email was generated by Open Journal Systems' Stripe plugin.<br />\n"
"<br />\n"
"Full post information for the request:<br />\n"
"{$postInfo}<br />\n"
"<br />\n"
"Additional information (if supplied):<br />\n"
"{$additionalInfo}<br />\n"
"<br />\n"
"Server vars:<br />\n"
"{$serverVars}<br />\n"

msgid "emails.stripeInvestigatePayment.description"
msgstr ""
"This email template is used to notify a journal's primary contact that "
"suspicious activity or activity requiring manual intervention was "
"encountered by the Stripe plugin."
