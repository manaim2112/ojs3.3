msgid "emails.qrisPaymentNotification.subject"
msgstr "QRIS Payment Notification"

msgid "emails.qrisPaymentNotification.body"
msgstr ""
"A QRIS payment needs to be processed for the journal {$contextName} and "
"the user {$userFullName} (username &quot;{$userName}&quot;).<br />\n"
"<br />\n"
"The item being paid for is &quot;{$itemName}&quot;.<br />\n"
"The cost is {$itemCost} ({$itemCurrencyCode}).<br />\n"
"<br />\n"
"This email was generated by Open Journal Systems' QRIS plugin."

msgid "emails.qrisPaymentNotification.description"
msgstr ""
"This email template is used to notify a journal manager contact that a "
"QRIS payment was requested."
